# ==============================================================================
# Librus Collector Configuration (.env)
# ==============================================================================

# 1. Librus Credentials
# Stored locally in plain text; strictly encrypted in transit via HTTPS and 
# transmitted ONLY to official Librus domains (api.librus.pl, synergia.librus.pl).
LIBRUS_LOGIN=your_librus_username_here
LIBRUS_PASSWORD=your_librus_password_here

# 2. Google Docs & NotebookLM Configuration
# The ID of the single Google Doc connected to your NotebookLM notebook.
# Find it in your Google Doc URL: https://docs.google.com/document/d/<GOOGLE_DOC_ID>/edit
GOOGLE_DOC_ID=

# 3. Google Cloud Authentication (Choose either Service Account OR OAuth2)
# Option A: Service Account (Recommended for headless/background daemons & cron)
# Download JSON key from Google Cloud Console and share your Google Doc with the service account email.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Option B: OAuth 2.0 User Client credentials (Desktop App)
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# 4. Fallback / Local Mode
# If Google credentials are not configured, updates will append to this local file.
LOCAL_EXPORT_PATH=librus_updates.md

# 5. Scheduling & Limits
# Sync interval in seconds (3600 = 1 hour)
SYNC_INTERVAL_SECONDS=3600

# Number of recent messages to inspect per run
FETCH_MESSAGES_LIMIT=50

# State persistence file for deduplication
LIBRUS_STATE_FILE=.librus_state.json

# Directory storing individual message markdown files with frontmatter (Option 3)
LIBRUS_ITEMS_DIR=data/items

# 6. Telegram Notifications (Optional)
# Send new school updates directly to a Telegram personal chat or channel
# Get bot token from @BotFather, and get your chat ID from @userinfobot or channel ID (-100...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 7. Document Layout & Ordering
# Where to insert new items during incremental sync: "beginning" (default) or "end"
INSERT_POSITION=beginning

# Whether to group items by category in compendium/rebuild: "false" (default, newest-first regardless of type) or "true"
GROUP_BY_TYPE=false

